		<AnalogPin>
			<Header>Analog pin</Header>
			<Description>Номер аналогового пина Firmata.</Description>
			<Type>| ptPubParameter | </Type>
			<DataSelectionType>0</DataSelectionType>
			<ValueList Type="std::vector" Size="2" elemType="std::string">
				<elem Type="std::string"></elem>
				<elem Type="std::string"></elem>
			</ValueList>
			<PropertyType>257</PropertyType>
		</AnalogPin>

		<BoardProfile>
			<Header>Board profile</Header>
			<Description>0=Uno, 1=Mega (для labels в GUI).</Description>
			<Type>| ptPubParameter | </Type>
			<DataSelectionType>0</DataSelectionType>
			<ValueList Type="std::vector" Size="2" elemType="std::string">
				<elem Type="std::string"></elem>
