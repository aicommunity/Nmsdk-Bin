		</UploadFirmware>
		<IsConnected>
			<Path>{CompName}:IsConnected</Path>
		</IsConnected>
		<HasError>
			<Path>{CompName}:HasError</Path>
		</HasError>
		<LastError>
			<Path>{CompName}:LastError</Path>
		</LastError>
	</Favorites>
</ClassDescription>
